msgid "Select this photo"
msgstr "勾選此照片"

#: src/ui/burst.rs:127
#, python-brace-format
msgid "Set frame {index} as representative"
msgstr "將第 {index} 幀設為代表幀"

#: src/ui/burst.rs:149
msgid "Export selected photos independently (no burst markers)"
msgstr "按所選獨立照片匯出（不寫連拍標記）"

#: src/ui/burst.rs:190
msgid "Burst Conversion Plan"
msgstr "連拍遷移計劃"

#: src/ui/burst.rs:195 src/ui/cover.rs:72
msgid "Done"
msgstr "完成"

#: src/ui/burst.rs:197
msgid "Save selection and return to workspace"
msgstr "儲存選擇並返回工作臺"

#: src/ui/cover.rs:67
msgid "Choose Cover"
msgstr "選擇封面"

#: src/ui/cover.rs:86
msgid "Reading high-resolution cover…"
msgstr "正在讀取高畫質封面…"

#: src/ui/cover.rs:119 src/ui/cover.rs:126
msgid "No other high-resolution covers found"
msgstr "未找到其他高畫質封面"

#: src/ui/cover.rs:145
msgid "Source cover"
msgstr "源封面"

#: src/ui/cover.rs:161
#, python-brace-format
msgid "Cover {seconds} s"
msgstr "封面 {seconds} 秒"

#: src/ui/cover.rs:204
msgid "Changing the cover does not affect the motion video. New covers are JPEG and do not preserve the original cover's HDR."
msgstr "更換封面不影響動態影片。新封面為 JPEG，不保留原封面的 HDR。"

