#: src/ui/flow.rs:49 src/ui/window.rs:109
msgid "Workflow"
msgstr "操作步骤"

#: src/ui/flow.rs:61
msgid "Complete workflow in five steps"
msgstr "完整操作流程，共五步"

#: src/ui/flow.rs:88
msgid "Back"
msgstr "返回"

#: src/ui/flow.rs:89
msgid "Go back one step, keeping the current selection and settings"
msgstr "返回上一步，保留当前选择和设置"

#: src/ui/flow.rs:218
#, python-brace-format
msgid "Step {step} of {count}"
msgstr "第 {step} 步 / 共 {count} 步"

#: src/ui/flow.rs:240
#, python-brace-format
msgid "View {step}, keeping the current selection and settings"
msgstr "查看{step}，保留当前选择和设置"

#: src/ui/flow.rs:245
#, python-brace-format
msgid "Finish the earlier steps to open {step}"
msgstr "完成前面的步骤后进入{step}"

#: src/ui/flow.rs:439
msgid "Choose a source and target on the left. Import options depend on this direction; choose processing features after importing."
msgstr "在左侧选择来源与目标。导入入口会按此方向开放，照片特性在导入后单独选择。"

#: src/ui/flow.rs:445
msgid "Changing direction reuses valid inspection data and rechecks eligibility. Sources and selections are retained; incompatible items show a reason."
msgstr "更改方向后复用有效解析，重新检查适用范围；保留来源和勾选，不兼容项会说明原因。"

#: src/ui/flow.rs:471
msgid "Sources"
msgstr "来源"

#: src/ui/flow.rs:475
msgid "Rescan Sources"
msgstr "重新检查来源"

#: src/ui/flow.rs:477
msgid "Clear Sources and List"
msgstr "清空来源与列表"

#: src/ui/flow.rs:483
msgid "Rescan or clear sources"
msgstr "重新检查或清空来源"

#: src/ui/flow.rs:487
msgid "Source Actions"
msgstr "来源操作"

#: src/ui/flow.rs:511
msgid "Add folders of photos; subfolders are included."
msgstr "添加照片文件夹；包含子文件夹。"

#: src/ui/flow.rs:520
msgid "Clear All Sources"
msgstr "清空所有来源"

#: src/ui/flow.rs:524
msgid "Clear this run's list only; never delete source files"
msgstr "只清空本轮列表，不删除原片"

#: src/ui/flow.rs:535
#, python-brace-format
msgid "{sources} sources · {photos} photos"
msgstr "{sources} 个入口 · {photos} 张"

#: src/ui/flow.rs:547
msgid "All Sources"
msgstr "全部来源"

#: src/ui/flow.rs:569 src/ui/flow.rs:571
msgid "Watch for Changes"
msgstr "监测变化"

#: src/ui/flow.rs:582
msgid "Remove Folder"
msgstr "移除文件夹"

#: src/ui/flow.rs:700 src/ui/queue.rs:924
msgid "Live Photo"
msgstr "实况照片"

#: src/ui/flow.rs:709
msgid "Format, Video, and Cover Options"
msgstr "格式、视频与封面选项"

#: src/ui/flow.rs:732 src/ui/queue.rs:915 src/ui/queue.rs:917
msgid "Burst"
msgstr "连拍"

#: src/ui/flow.rs:741
msgid "Choose Burst Members and Representative…"
msgstr "选择连拍成员与代表照片…"

#: src/ui/flow.rs:753
msgid "Export Unchanged Photos"
msgstr "输出未修改的照片"

#: src/ui/flow.rs:765
msgid "Export complete, unchanged source resources. Choose the location in Export Preview."
msgstr "完整输出未转换的原资源；位置在导出预览中选择。"

#: src/ui/flow.rs:772
msgid "Photo Dates"
msgstr "照片时间"

#: src/ui/flow.rs:773
msgid "Enable only when photo dates appear out of order in Photos. Source files are not modified."
msgstr "仅在相册中的照片时间错乱时开启。原片不改写。"

#: src/ui/flow.rs:789
msgid "Fill missing capture dates (PhotoTime)"
msgstr "补全缺失的拍摄时间（PhotoTime）"

#: src/ui/flow.rs:790
msgid "Recognize a date or Unix timestamp from the original filename. Fill missing dates only in output copies; existing nonempty dates stay unchanged."
msgstr "从原文件名识别日期或 Unix 时间，只补全输出副本中的缺失时间；已有非空时间保持不变。"

#: src/ui/flow.rs:805
msgid "Generate synthetic ordering dates when recognition fails"
msgstr "无法识别时生成合成排序时间"

#: src/ui/flow.rs:808
msgid "Synthetic dates are not actual capture dates. They follow natural filename order at one-second intervals. Time zone: "
msgstr "合成时间不是真实拍摄时间；按原文件名自然顺序逐张增加一秒。时区："

#: src/ui/flow.rs:814
msgid "If a motion container or HDR resource cannot be fully verified, it is not published or split into a still; see Export Preview for the reason."
msgstr "动态容器或 HDR 资源无法完整验证时不发布，也不会拆成静态图；请在导出预览查看原因。"

#: src/ui/flow.rs:818
msgid "Set output file dates from EXIF"
msgstr "将 EXIF 时间写入输出文件时间"

#: src/ui/flow.rs:819
msgid "Independently set creation and modification dates; off by default. After repair, read actual EXIF dates. Without usable EXIF, keep source file dates."
msgstr "独立控制创建和修改时间，默认关闭；补缺后读取实际 EXIF，无可用 EXIF 时沿用来源文件时间。"

#: src/ui/flow.rs:830
msgid "HDR (experimental, off by default)"
msgstr "HDR（实验性，默认关闭）"

#: src/ui/flow.rs:831
msgid "Only supported HDR profiles are attempted. Unsupported items are listed in preview; the original device's HDR appearance is not guaranteed."
msgstr "仅尝试已支持的 HDR 配置；不支持项会在预览列出，不保证还原原厂显示效果。"

#: src/ui/flow.rs:856
msgid "Output content"
msgstr "导出内容"

#: src/ui/flow.rs:867
